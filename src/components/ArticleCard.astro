---
interface Props { href: string; title: string; description: string; publishedAt: Date; tags: string[]; }
const { href, title, description, publishedAt, tags } = Astro.props;
const dateLabel = publishedAt.toLocaleDateString('en-GB', { dateStyle: 'long', timeZone: 'UTC' });
---
<article class="article-card">
  <p class="meta-line"><time datetime={publishedAt.toISOString()}>{dateLabel}</time> · Bartosz Burda</p>
  <h3><a href={href}>{title}</a></h3><p>{description}</p>
  {tags.length > 0 && <ul class="tag-list" aria-label="Topics">{tags.map((tag) => <li>{tag}</li>)}</ul>}
</article>
