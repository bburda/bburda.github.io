---
import WritingRow from '../../components/WritingRow.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedArticles } from '../../lib/articles';
const description = 'Notes on what I happen to be working on. Often embedded systems and diagnostics, not always.';
const articles = await getPublishedArticles();
---
<BaseLayout title="Educational Articles | Bartosz Burda" description={description} canonicalPath="/articles/">
  <div class="shell page">
    {/* a label, not a heading: the h1 below is this page's first heading */}
    <div class="sec-head"><p>Writing</p><p><a href="/rss.xml">RSS feed</a></p></div>
    <h1>Educational articles</h1>
    <p class="page__lede">{description}</p>
    <div class="archive">
      {articles.length === 0
        ? <p class="write-empty">No articles published yet.</p>
        : articles.map(({ entry, routeSlug, tags }) => (
            <WritingRow href={`/articles/${routeSlug}/`} title={entry.data.title} description={entry.data.description} publishedAt={entry.data.publishedAt} tags={tags} level={2} />
          ))}
    </div>
  </div>
</BaseLayout>
