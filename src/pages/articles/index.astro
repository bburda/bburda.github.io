---
import ArticleCard from '../../components/ArticleCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedArticles } from '../../lib/articles';
const description = 'Notes on automotive diagnostics, SOVD, ROS 2, reliable embedded systems and engineering workflows.';
const articles = await getPublishedArticles();
---
<BaseLayout title="Educational Articles | Bartosz Burda" description={description} canonicalPath="/articles/">
  <section class="shell archive-page"><p class="eyebrow">Bartosz Burda</p><h1>Educational articles</h1><p class="lede">{description}</p>
    <p><a class="text-link" href="/rss.xml">RSS feed</a></p>
    {articles.length === 0 ? <p class="empty-state">No articles published yet.</p> : <div class="article-grid">{articles.map(({ entry, routeSlug, tags }) => <ArticleCard href={`/articles/${routeSlug}/`} title={entry.data.title} description={entry.data.description} publishedAt={entry.data.publishedAt} tags={tags} />)}</div>}
  </section>
</BaseLayout>
