---
import MorphStage from '../components/MorphStage.astro';
import WritingRow from '../components/WritingRow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedArticles } from '../lib/articles';

const title = 'Bartosz Burda | Embedded Software Architect';
const description = 'Bartosz Burda is an Embedded Software Architect and co-founder of selfpatch.ai. He builds the diagnostic and recovery layer for robots, PLCs and vehicles.';
const articles = await getPublishedArticles();

// sameAs means "the same entity", so it holds profiles of the person only. The company belongs in
// worksFor. bburda42dot is the former work account, named in the body of the page as well.
const profile = {
  '@context': 'https://schema.org', '@type': 'ProfilePage', '@id': 'https://bburda.github.io/#profile',
  url: 'https://bburda.github.io/',
  mainEntity: {
    '@type': 'Person', '@id': 'https://bburda.github.io/#bartosz-burda',
    name: 'Bartosz Burda', givenName: 'Bartosz', familyName: 'Burda', alternateName: 'bburda',
    jobTitle: 'Embedded Software Architect', description,
    url: 'https://bburda.github.io/', mainEntityOfPage: 'https://bburda.github.io/',
    image: 'https://bburda.github.io/portrait.jpg',
    address: { '@type': 'PostalAddress', addressCountry: 'PL' },
    worksFor: { '@type': 'Organization', '@id': 'https://www.selfpatch.ai/#organization', name: 'selfpatch.ai', url: 'https://www.selfpatch.ai/' },
    alumniOf: { '@type': 'CollegeOrUniversity', name: 'West Pomeranian University of Technology in Szczecin', url: 'https://www.zut.edu.pl/' },
    knowsAbout: ['SOVD / ISO 17978', 'UDS / ISO 14229', 'DoIP / ISO 13400', 'ISO 26262', 'ISO 21434', 'AUTOSAR', 'ROS 2', 'Robot diagnostics', 'Software-defined vehicles', 'C++', 'Rust'],
    sameAs: ['https://github.com/bburda', 'https://www.linkedin.com/in/bartosz-burda/', 'https://github.com/bburda42dot'],
  },
};

const roles = [
  { when: 'May 2026 - present', title: 'Co-Founder', org: 'selfpatch.ai', note: 'Solution architecture and product direction for robot diagnostics and recovery tooling.' },
  { when: 'Jul 2025 - Apr 2026', title: 'OS Tool System Engineer', org: '42dot', note: 'Tooling and infrastructure for a Software-Defined Vehicle OS; Eclipse OpenSOVD contributions. Rust, Python, Docker, GitLab CI, Renode, Bazel.' },
  { when: 'Sep 2024 - Jun 2025', title: 'Solutions Architect', org: 'OpenTier', note: 'Cloud-native IoT platform for connected fleets; ROS 2 and Zenoh edge-to-cloud streaming; agentic AI microservices. Rust, C++, Python, TypeScript, MongoDB, InfluxDB, PostgreSQL, AWS.' },
  { when: 'Sep 2022 - Jun 2024', title: 'Senior Software Engineer', org: 'Apex.AI', note: 'UDS (ISO 14229) and DoIP (ISO 13400) diagnostic modules for Apex.OS; SOME/IP serialization and an E2E protection library.' },
  { when: 'Jan 2022 - Jul 2022', title: 'Lead Software Architect', org: 'Spyrosoft', note: 'E-bike connectivity system; FOTA update design and driver and occupancy monitoring. AUTOSAR Classic, MISRA C, UML2/SysML.' },
  { when: 'Jul 2021 - Dec 2021', title: 'Technical Lead and Software Architect', org: 'Siili Auto', note: 'HMI and middleware for digital clusters on QNX 7.0 and Android Automotive, Qt 5.15/QML; DDS, CAN, LIN; ASPICE and ISO 26262 ASIL B workflows.' },
  { when: 'Mar 2020 - Jun 2021', title: 'Senior Software Engineer and Consultant', org: 'umlaut', note: 'Product Owner for an Adaptive AUTOSAR platform; Industry 4.0 hot-runner controller; RFQ and RFP responses.' },
  { when: 'Jul 2019 - Feb 2020', title: 'Senior Software Engineer', org: 'GlobalLogic', note: 'Emergency-call (eCall) service modules for telematics ECUs; ISO 26262 ASIL B safety modules.' },
  { when: 'Jun 2018 - Jun 2019', title: 'Software Engineer', org: 'Mobica', note: 'AUTOSAR Adaptive positioning: map and lane matching, with OEMs and Tier 1 suppliers.' },
  { when: 'Feb 2018 - May 2018', title: 'Java Server Developer', org: 'Huuuge Games', note: 'Backend performance and scalability for online multiplayer.' },
  { when: 'Jun 2017 - Jan 2018', title: 'Software Engineer', org: 'Mobica', note: 'ERP modules and vending machine control software.' },
  { when: 'Jan 2016 - May 2017', title: 'Junior Software Engineer', org: 'brightONE Poland (now Codelab)', note: 'HIL/SIL desktop test automation for in-vehicle infotainment: CAN, HMI, audio, connectivity.' },
  { when: 'Jul 2015 - Sep 2015', title: 'Trainee', org: 'brightONE Poland', note: 'The same HIL/SIL infotainment test automation, before the junior role.' },
];

// Counts are the state on 2026-08-05. Refresh them when a pull request lands.
const umbrellas = [
  {
    title: 'Eclipse OpenSOVD',
    right: 'Merged / in review',
    note: 'Diagnostics work done at 42dot, under the @bburda42dot account.',
    noteHref: 'https://github.com/bburda42dot',
    rows: [
      { name: 'cicd-workflows', what: 'Reusable Rust build, test, coverage and Miri pipelines for the project repositories', ref: '2 merged', href: 'https://github.com/eclipse-opensovd/cicd-workflows/pulls?q=is%3Apr+author%3Abburda42dot+is%3Amerged' },
      { name: 'fault-lib', what: 'A diagnostic fault library: the DFM core and the SOVD interface on top of it', ref: '#7 in review', href: 'https://github.com/eclipse-opensovd/fault-lib/pull/7' },
      { name: 'mdd-ui', what: 'Diff view for MDD trees, and exporting a diff to a text file', ref: '#17 merged', href: 'https://github.com/alexmohr/mdd-ui/pull/17' },
      { name: 'diagnostic_yaml_proposal', what: 'A YAML schema for diagnostic data, a converter to MDD, and CDA integration', ref: 'repo', href: 'https://github.com/bburda42dot/diagnostic_yaml_proposal' },
      { name: 'diag-converter', what: 'ODX and MDD conversion: protocols, ECU shared data, comparams, DTC handling', ref: 'repo', href: 'https://github.com/bburda42dot/diag-converter' },
    ],
  },
  {
    title: 'Spec-driven AI engineering',
    right: 'Open source',
    rows: [
      { name: 'pharaoh-skills', what: 'A gated V-model workflow, atomic agent skills, review and grounding axes', ref: '6 merged', href: 'https://github.com/useblocks/pharaoh-skills/pulls?q=is%3Apr+author%3Abburda+is%3Amerged' },
      { name: 'ai_memory_protocol', what: 'A small experiment: Sphinx-Needs as structured memory an agent can query', ref: 'repo', href: 'https://github.com/bburda/ai_memory_protocol' },
    ],
  },
];

const stack = [
  { label: 'Standards', ink: false, items: ['SOVD / ISO 17978', 'UDS / ISO 14229', 'DoIP / ISO 13400', 'ISO 26262', 'ISO 21434', 'AUTOSAR', 'ASPICE', 'MISRA'] },
  { label: 'Platforms', ink: false, items: ['Embedded Linux', 'QNX', 'Android Automotive', 'Bare metal'] },
  { label: 'Middleware', ink: false, items: ['ROS 2', 'DDS', 'Zenoh', 'SOME/IP', 'CAN', 'LIN'] },
  { label: 'Languages', ink: true, items: ['C++', 'Rust', 'Python', 'TypeScript'] },
];

// Published on someone else's site. Linked, never copied, so the original stays canonical.
const published = [
  {
    stamp: '2026-07', where: 'Foxglove blog',
    title: "When you can't reach the robot: SOVD diagnostics and OTA updates in Foxglove via the ros2_medkit extension",
    what: 'Diagnosing a robot and pushing an OTA fix from Foxglove after the network is gone.',
    href: 'https://foxglove.dev/blog/sovd-diagnostics-and-ota-updates-in-foxglove-via-ros2-medkit',
  },
  {
    stamp: '2026-03', where: 'selfpatch.ai',
    title: 'ros2_medkit 0.4.0 - Production Diagnostics for ROS 2 Fleets',
    what: 'Condition-based triggers, remote diagnostic scripts, resource locking and log aggregation.',
    href: 'https://www.selfpatch.ai/articles/en/ros2-medkit-040-release',
  },
];

// No address in the markup. A plain mailto is harvested by scrapers within days, and the two
// profiles below both carry a message box.
//
// rel="me" is the HTML counterpart of sameAs: it asserts "this profile is me". The two personal
// profiles carry it; the company is not a profile of the person.
const contact = [
  { name: 'LinkedIn', ref: 'bartosz-burda', href: 'https://www.linkedin.com/in/bartosz-burda/', me: true },
  { name: 'GitHub', ref: '@bburda', href: 'https://github.com/bburda', me: true },
  { name: 'selfpatch.ai', ref: 'The company', href: 'https://www.selfpatch.ai/', me: false },
];
---
<BaseLayout {title} {description} canonicalPath="/" ogType="profile">
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(profile)} />

  <div class="shell">

    <section class="hero">
      <div>
        <p class="hero__eyebrow">Hello, I'm</p>
        {/* two block spans, not a <br>: a <br> leaves textContent as the fused "BartoszBurda" */}
        <h1><span>Bartosz</span> <span>Burda</span></h1>
        <p class="hero__line"><b>Embedded Software Architect.</b></p>
        <p class="hero__sub">I build the diagnostic and recovery layer for robots.</p>
        <div class="hero__links">
          <a class="btn btn--primary" rel="me" href="https://www.linkedin.com/in/bartosz-burda/">LinkedIn</a>
          <a class="btn" rel="me" href="https://github.com/bburda">GitHub</a>
          <a class="btn" href="https://www.selfpatch.ai/">selfpatch.ai</a>
        </div>
      </div>
      <div class="portrait">
        <img src="/portrait.jpg" width="460" height="460" alt="Portrait of Bartosz Burda" fetchpriority="high" />
      </div>
    </section>

    <section id="about" class="section">
      <div class="sec-head"><h2>01 / About</h2><p>Who this is</p></div>
      <div class="about">
        <dl class="facts">
          <div><dt>Field</dt><dd>Robotics, PLCs, automotive diagnostics</dd></div>
          <div><dt>Now</dt><dd>Co-founder, <a href="https://www.selfpatch.ai/">selfpatch.ai</a></dd></div>
          <div><dt>Since</dt><dd>2015, in embedded software</dd></div>
        </dl>
        <p>
          I co-founded <a href="https://www.selfpatch.ai/">selfpatch.ai</a>. Before that I spent about ten years on
          diagnostics for cars. When I moved to robots I found the same problems: failures that are hard to debug, no
          standard way to ask a machine what is wrong, and almost nothing shared between vendors. Cars settled this
          decades ago and wrote it into standards. Robots have not.
        </p>
      </div>
    </section>

    <section id="experience" class="section">
      <div class="sec-head"><h2>02 / The road so far</h2><p>Now: robots &#8592; back then: cars · 13 roles</p></div>
      <div class="road">
        <MorphStage />
        <div class="roadmap" data-roadmap>
          {roles.map((role) => (
            <article class="role" data-role>
              <div><div class="role__dot" aria-hidden="true"></div></div>
              <div>
                <p class="role__when">{role.when}</p>
                <h3 class="role__title">{role.title}</h3>
                <p class="role__org">{role.org}</p>
                {role.note && <p class="role__note">{role.note}</p>}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="work" class="section">
      <div class="sec-head"><h2>03 / Selected work</h2><p>Open source</p></div>

      <div class="project">
        <div class="project__head">
          <div>
            <p class="project__kind">Open-source project</p>
            <h3><a href="https://github.com/selfpatch/ros2_medkit">ros2_medkit</a></h3>
          </div>
          <div>
            <p class="project__note">
              Open-source SOVD diagnostics gateway for ROS 2. Entity discovery, typed clients and a web UI over a
              C++17 REST gateway. Creator and primary contributor.
            </p>
            <ul class="chips">
              <li>C++17</li><li>REST / OpenAPI</li><li>ROS 2</li><li>SOVD / ISO 17978</li>
            </ul>
            <p class="project__links">
              <a href="https://github.com/selfpatch/ros2_medkit">Repository &#8594;</a>
              <a href="https://selfpatch.github.io/ros2_medkit/">Documentation &#8594;</a>
            </p>
          </div>
        </div>
        <img class="project__shot" src="/work/ros2-medkit-ui.png" width="2560" height="1600" loading="lazy"
          alt="The ros2_medkit web UI: a SOVD entity tree of areas, components and apps discovered from a live ROS 2 graph, beside the overview panel for the selected area." />
      </div>

      {umbrellas.map((group) => (
        <div class="upstream">
          <div class="sec-head sec-head--strong"><h3>{group.title}</h3><p>{group.right}</p></div>
          {group.note && <p class="upstream__note"><a href={group.noteHref}>{group.note}</a></p>}
          {group.rows.map((item) => (
            <a class="row row--upstream" href={item.href}>
              <span class="row__name">{item.name}</span>
              <span class="row__what">{item.what}</span>
              <span class="row__ref">{item.ref} &#8594;</span>
            </a>
          ))}
        </div>
      ))}
    </section>

    <section id="writing" class="section">
      <div class="sec-head"><h2>04 / Writing</h2><p>Notes on diagnostics</p></div>
      {articles.length === 0
        ? <p class="write-empty">Nothing on this site yet. New notes appear here and in the <a href="/rss.xml">RSS feed</a>.</p>
        : articles.slice(0, 5).map(({ entry, routeSlug, tags }) => (
            <WritingRow href={`/articles/${routeSlug}/`} title={entry.data.title} description={entry.data.description} publishedAt={entry.data.publishedAt} tags={tags} />
          ))}
      {articles.length > 0 && <p class="write-more"><a href="/articles/">All articles &#8594;</a></p>}

      <div class="upstream">
        <div class="sec-head sec-head--strong"><h3>Published elsewhere</h3><p>Linked, not copied</p></div>
        {published.map((item) => (
          <a class="row row--article" href={item.href}>
            <span class="write-row__when"><time datetime={item.stamp}>{item.stamp}</time></span>
            <span>
              <span class="row__name">{item.title}</span>
              <span class="row__what">{item.what}</span>
            </span>
            <span class="row__ref">{item.where} &#8594;</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="sec-head"><h2>05 / Standards and stack</h2><p>What I work in</p></div>
      <dl>
        {stack.map((group) => (
          <div class="stack-row">
            <dt>{group.label}</dt>
            <dd><ul class={group.ink ? 'chips chips--ink' : 'chips'}>{group.items.map((item) => <li>{item}</li>)}</ul></dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="section">
      <div class="sec-head"><h2>06 / Education</h2><p>2012 - 2016</p></div>
      <div class="edu">
        <div>
          <h3>B.Sc. in Automatic Control and Robotics</h3>
          <p class="edu__where">West Pomeranian University of Technology, Szczecin</p>
        </div>
        <p>
          Thesis: <em>Mobile robot position identification using Kinect camera</em>. Ten years later the same question -
          where is the machine and what state is it in - is still the job.
        </p>
      </div>
    </section>

    <section id="contact" class="section">
      <div class="sec-head"><h2>07 / Contact</h2><p>LinkedIn is fastest</p></div>
      <div class="elsewhere">
        <p class="elsewhere__claim">Message me on LinkedIn, or read the code first.</p>
        <ul>
          {contact.map((link) => (
            <li><a href={link.href} rel={link.me ? 'me' : undefined}>
              <span class="elsewhere__name">{link.name}</span>
              <span class="elsewhere__ref">{link.ref} &#8594;</span>
            </a></li>
          ))}
        </ul>
      </div>
    </section>

  </div>
</BaseLayout>
