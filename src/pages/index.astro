---
import ArticleCard from '../components/ArticleCard.astro';
import ExternalLink from '../components/ExternalLink.astro';
import ProofCard from '../components/ProofCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedArticles } from '../lib/articles';
const title = 'Bartosz Burda | Embedded Software Architect';
const description = 'Bartosz Burda is an Embedded Software Architect and co-founder of selfpatch, building automotive diagnostics, ROS 2 and SOVD tooling.';
const articles = await getPublishedArticles();
const profile = {
  '@context': 'https://schema.org', '@type': 'ProfilePage', url: 'https://bburda.github.io/',
  mainEntity: {
    '@type': 'Person', '@id': 'https://bburda.github.io/#bartosz-burda', name: 'Bartosz Burda', alternateName: 'bburda',
    jobTitle: 'Embedded Software Architect', description, url: 'https://bburda.github.io/',
    image: 'https://avatars.githubusercontent.com/u/24573178?s=512',
    sameAs: ['https://github.com/bburda', 'https://www.linkedin.com/in/bartosz-burda'],
    affiliation: { '@type': 'Organization', name: 'selfpatch', url: 'https://www.selfpatch.ai/' },
    knowsAbout: ['Automotive diagnostics', 'Embedded software architecture', 'ROS 2', 'SOVD', 'Software-defined vehicles', 'C++', 'Rust'],
  },
};
---
<BaseLayout {title} {description} canonicalPath="/" ogType="profile">
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(profile)} />
  <section class="hero shell"><div><p class="eyebrow">Bartosz Burda</p>
    <h1>Embedded architect building diagnostics for software-defined vehicles and robots.</h1>
    <p class="lede">Since 2015, I have designed automotive, embedded and IoT systems, from safety-critical vehicle software to cloud-connected robotics platforms. I am a co-founder of selfpatch and the creator and primary contributor of ros2_medkit.</p>
    <ul class="hero-links"><li><a class="button" href="https://github.com/selfpatch/ros2_medkit">Explore ros2_medkit</a></li><li><a class="button secondary" href="https://github.com/bburda">View GitHub</a></li><li><a class="button secondary" href="https://www.linkedin.com/in/bartosz-burda">LinkedIn</a></li></ul>
  </div><img src="https://avatars.githubusercontent.com/u/24573178?s=512" width="512" height="512" alt="Portrait of Bartosz Burda" /></section>

  <section id="work" class="shell section"><p class="eyebrow">Selected work</p><h2>Systems and workflows I build</h2><div class="proof-grid">
    <ProofCard id="ros2-medkit" title="selfpatch / ros2_medkit" context="Open-source diagnostics and observability for ROS 2 robots and connected machines." role="Co-founder of selfpatch, creator and primary contributor of ros2_medkit." contribution="A C++ diagnostics gateway with an API-first, SOVD-aligned REST surface, plus Python MCP tooling, a React web interface, typed clients, demos and documentation." evidence={[
      { label: 'Repository', href: 'https://github.com/selfpatch/ros2_medkit' }, { label: 'Contributor history', href: 'https://github.com/selfpatch/ros2_medkit/graphs/contributors' }, { label: 'Documentation', href: 'https://selfpatch.github.io/ros2_medkit/' }, { label: 'MCP server', href: 'https://github.com/selfpatch/ros2_medkit_mcp' }, { label: 'Web UI', href: 'https://github.com/selfpatch/ros2_medkit_web_ui' },
    ]} />
    <ProofCard id="opensovd-history" title="OpenSOVD contributions while at 42dot" context="Past professional work in the Eclipse OpenSOVD ecosystem, completed before May 2026." role="OS Tool System Engineer at 42dot from July 2025 to April 2026. Contributions used my former work account, @bburda42dot." contribution="YAML-to-MDD diagnostic tooling, reusable Rust build, test, coverage and Miri workflows, and MDD diff visualization." note="This work is separate from selfpatch and ros2_medkit." evidence={[
      { label: 'YAML-to-MDD tooling', href: 'https://github.com/bburda42dot/diagnostic_yaml_proposal' }, { label: 'Merged Rust CI workflows', href: 'https://github.com/eclipse-opensovd/cicd-workflows/pull/18' }, { label: 'Merged MDD visualization', href: 'https://github.com/alexmohr/mdd-ui/pull/17' },
    ]} />
    <ProofCard id="spec-driven" title="Spec-driven engineering" context="Requirements and V-model workflows for engineering teams and coding agents." role="Contributor to public useblocks engineering workflows." contribution="A gated V-model workflow, requirements engineering guidance, agent skills and docs-as-code tooling." evidence={[{ label: 'Merged pharaoh-sdd contribution', href: 'https://github.com/useblocks/pharaoh-skills/pull/21' }]} />
  </div></section>

  <section id="articles" class="shell section"><p class="eyebrow">Articles</p><h2>Educational articles</h2><p>Notes on automotive diagnostics, SOVD, ROS 2, reliable embedded systems and engineering workflows.</p>
    {articles.length === 0 ? <p class="empty-state">No articles published yet.</p> : <div class="article-grid">{articles.slice(0, 3).map(({ entry, routeSlug, tags }) => <ArticleCard href={`/articles/${routeSlug}/`} title={entry.data.title} description={entry.data.description} publishedAt={entry.data.publishedAt} tags={tags} />)}</div>}
    <p><a class="text-link" href="/articles/">Browse the article archive</a> · <a class="text-link" href="/rss.xml">RSS feed</a></p>
  </section>

  <section id="expertise" class="shell section"><p class="eyebrow">Expertise</p><h2>Technical focus</h2><div class="expertise-grid">
    <article><h3>Diagnostics and standards</h3><ul><li>SOVD / ISO 17978</li><li>UDS / ISO 14229</li><li>DoIP / ISO 13400</li><li>AUTOSAR</li><li>ISO 26262</li><li>ASPICE</li></ul></article>
    <article><h3>Embedded and vehicle platforms</h3><ul><li>Embedded Linux</li><li>QNX</li><li>Android Automotive</li><li>bare metal</li><li>SOME/IP</li><li>CAN</li></ul></article>
    <article><h3>Robotics and distributed systems</h3><ul><li>ROS 2</li><li>DDS</li><li>Zenoh</li><li>REST</li><li>gRPC</li><li>cloud-connected systems</li></ul></article>
    <article><h3>Languages and delivery</h3><ul><li>C++</li><li>Rust</li><li>Python</li><li>TypeScript</li><li>Docker</li><li>CI/CD</li></ul></article>
  </div></section>

  <section id="evidence" class="shell section"><p class="eyebrow">Selected public evidence</p><h2>Verify the work</h2><ul class="evidence-list">
    <li><ExternalLink label="ros2_medkit Diagnostics accepted into the Foxglove Extension Registry" href="https://github.com/foxglove/extension-registry/pull/84" /></li>
    <li><ExternalLink label="Reusable Rust CI/CD workflows merged into Eclipse OpenSOVD" href="https://github.com/eclipse-opensovd/cicd-workflows/pull/18" /></li>
    <li><ExternalLink label="Gated V-model workflow merged into useblocks/pharaoh-skills" href="https://github.com/useblocks/pharaoh-skills/pull/21" /></li>
    <li><ExternalLink label="ros2_medkit 0.4 technical deep dive" href="https://www.selfpatch.ai/articles/en/ros2-medkit-040-release" /></li>
  </ul></section>

  <section id="about" class="shell section about-grid"><div><p class="eyebrow">About</p><h2>Architecture through verification</h2><p>I hold a B.Sc. in Automatic Control and Robotics from the West Pomeranian University of Technology in Szczecin. I work across architecture, implementation, integration and verification, with a focus on reliable systems that connect embedded devices, vehicles, robots and cloud services.</p><p><strong>Languages:</strong> Polish (native), English (C1), Chinese (HSK 3).</p></div>
    <div id="contact"><p class="eyebrow">Contact</p><h2>Let's connect</h2><p>For professional contact, use LinkedIn or GitHub. For selfpatch and ros2_medkit, visit selfpatch.ai.</p><ul class="contact-list"><li><ExternalLink label="LinkedIn" href="https://www.linkedin.com/in/bartosz-burda" /></li><li><ExternalLink label="GitHub" href="https://github.com/bburda" /></li><li><ExternalLink label="selfpatch.ai" href="https://www.selfpatch.ai/" /></li><li><ExternalLink label="ros2_medkit documentation" href="https://selfpatch.github.io/ros2_medkit/" /></li></ul></div>
  </section>
</BaseLayout>
