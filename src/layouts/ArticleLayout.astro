---
import BaseLayout from './BaseLayout.astro';
interface Props { title: string; description: string; routeSlug: string; publishedAt: Date; updatedAt?: Date; tags: string[]; }
const { title, description, routeSlug, publishedAt, updatedAt, tags } = Astro.props;
const canonicalPath = `/articles/${routeSlug}/`;
const date = (value: Date) => value.toLocaleDateString('en-GB', { dateStyle: 'long', timeZone: 'UTC' });
const modified = updatedAt ?? publishedAt;
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'BlogPosting',
  mainEntityOfPage: new URL(canonicalPath, Astro.site).href, url: new URL(canonicalPath, Astro.site).href,
  headline: title, description, datePublished: publishedAt.toISOString(), dateModified: modified.toISOString(),
  author: { '@type': 'Person', '@id': 'https://bburda.github.io/#bartosz-burda', name: 'Bartosz Burda', url: 'https://bburda.github.io/' },
  keywords: tags,
};
---
<BaseLayout title={`${title} | Bartosz Burda`} description={description} canonicalPath={canonicalPath} ogType="article">
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="shell page">
    <div class="sec-head"><p>Educational article</p><p><a href="/articles/">All articles</a></p></div>
    <h1>{title}</h1>
    <p class="page__lede">{description}</p>
    <p class="article-meta">Written by <a href="/#about">Bartosz Burda</a> · Published <time datetime={publishedAt.toISOString()}>{date(publishedAt)}</time>{updatedAt && updatedAt.getTime() !== publishedAt.getTime() && <> · Updated <time datetime={updatedAt.toISOString()}>{date(updatedAt)}</time></>}</p>
    {tags.length > 0 && <ul class="chips" aria-label="Topics" style="margin-top:16px">{tags.map((tag) => <li>{tag}</li>)}</ul>}
    <div class="prose" role="region" aria-label="Article content"><slot /></div>
    <p class="back-link"><a href="/articles/">&#8592; Back to all articles</a></p>
  </article>
</BaseLayout>
